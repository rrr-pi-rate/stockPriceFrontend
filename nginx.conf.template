server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Exact match only: the app's own "/dashboard" SPA route shares the same path segment as
    # this API endpoint. A prefix location (e.g. "/dashboard/") also matches the try_files
    # $uri/ fallback for the bare "/dashboard" route, which makes nginx 301-redirect it to
    # "/dashboard/" and proxy it to the backend instead of serving the Angular app.
    location = /dashboard/data {
        proxy_pass ${BACKEND_BASE_URL}/dashboard/data;
    }

    location = /dashboard/benchmark {
        proxy_pass ${BACKEND_BASE_URL}/dashboard/benchmark;
    }

    # Visit tracking (IP/OS -> Prometheus + Loki in the backend). Cloudflare's CF-Connecting-IP
    # header is passed through by default; X-Forwarded-For/X-Real-IP cover non-Cloudflare access.
    location ~ ^/track/(landing|dashboard)$ {
        proxy_pass ${BACKEND_BASE_URL};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
