# Samme app tilgås via LAN-IP, Tailscale-IP og MagicDNS-kortnavn. Et .ts.net-navn må ikke bruges
# her: Caddy forsøger så at hente et offentligt certifikat hos Tailscale/Let's Encrypt.
https://192.168.1.239, https://100.117.118.77, https://raspberrypi {
	tls internal
	reverse_proxy localhost:8081
}
